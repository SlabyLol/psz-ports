name: PSZ CI/CD & Unit Tests

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  run-unit-tests:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      - name: Build and Run Unit Tests
        run: |
          cd tests
          make

  build-psp:
    needs: run-unit-tests
    runs-on: ubuntu-latest
    container: pspdev/pspdev:latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      - name: Build PSP
        run: |
          cd platforms/psp
          make eboot

  build-3ds:
    needs: run-unit-tests
    runs-on: ubuntu-latest
    container: devkitpro/devkitarm:latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      - name: Build 3DS
        run: |
          cd platforms/3ds
          make

  build-wii-wiiu:
    needs: run-unit-tests
    runs-on: ubuntu-latest
    container: devkitpro/devkitppc:latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      - name: Build Wii
        run: |
          cd platforms/wii
          make
      - name: Build Wii U
        run: |
          cd platforms/wiiu
          make
